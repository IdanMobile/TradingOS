# --- Secrets: never commit ---
.env
.env.*
.env.local
.env.*.local
*.pem
*.key
*credentials*.json
*service-account*.json
secrets/

# .env.example IS committed (names/comments only)
!.env.example

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venvs/
*.egg-info/
.pytest_cache/
.hypothesis/
.mypy_cache/
.ruff_cache/

# --- Engine environments (rebuilt from manifests) ---
engines/*/.venv/
engines/*/venv/

# --- Data & runtime artifacts (regenerated; manifests are committed) ---
data/raw/*
!data/raw/manifests/
!data/raw/manifests/*.json
!data/raw/manifests/**/*.json
# Small content-addressed REST update pages are provenance inputs, not disposable cache.
!data/raw/rest_klines/
!data/raw/rest_klines/**/
!data/raw/rest_klines/**/*.json
data/normalized/
mlruns/
mlartifacts/
*.duckdb
*.sqlite
*.db

# --- Build/run logs (not guaranteed secret-free) ---
*.log

# --- DVC local state (WS4; caches may hold tokens/creds later) ---
.dvc/cache/
.dvc/tmp/

# --- Local assistant/session config ---
.claude/

# --- OS / editor ---
.DS_Store
.idea/
.vscode/

# --- Engine lane working dirs (rebuilt from code; artifacts live in artifacts/) ---
engines/*/lane/
artifacts/**/*.zip

# Optional external-news metadata cache (regenerated server-side)
artifacts/news/

# --- Raw bakeoff engine dumps (100s of MB; manifest/metrics/parquet summaries are committed) ---
artifacts/bakeoff/**/raw.json

# --- DVC lineage prototype demo data (regenerable scratch, not evidence) ---
artifacts/lineage/prototype/

# Mutable prospective-observer liveness; immutable sessions are committed evidence.
artifacts/prospective/*/operations/status.json

# --- Operator attestation ---
# The filled attestation states account eligibility, fee tier, and capital limits.
# It holds no credentials, but it is operator-personal. Only the template is committed.
ops/OPERATOR_ATTESTATION.json
!ops/OPERATOR_ATTESTATION.example.json
